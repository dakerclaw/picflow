# PicFlow 环境变量配置
# 复制此文件为 .env 使用。启动时会读取它，且**已存在的真实环境变量优先**
# （Docker 的 environment、systemd 的 EnvironmentFile 不受影响）。

PORT=3000
NODE_ENV=production

# JWT 密钥：负责签发站点访问令牌、分享令牌和用户登录态。
# 留空即可 —— 服务端首次启动会生成一个随机密钥并保存到数据目录下的
# .jwt-secret（Docker 里是 data/.jwt-secret），重启后复用。
# 只有想自己管理密钥时才填，请填 32 位以上的随机串。
JWT_SECRET=

# 上传文件存储目录
UPLOAD_DIR=./uploads

# SQLite 数据库路径
DB_PATH=./picflow.db

# 反向代理：站点前面挂了 nginx / Caddy 等反代时设为 1，否则所有访客会被
# 当成同一个 IP（密码连续输错 10 次会锁全站）。若容器端口能被公网直连，
# 则保持注释状态，否则别人伪造 X-Forwarded-For 就能无限次试密码。
# TRUST_PROXY=1
